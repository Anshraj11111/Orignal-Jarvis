{
  "manifest_version": 3,
  "name": "GyaanBot Assistant",
  "version": "1.0",
  "description": "Voice assistant that works everywhere",
  "permissions": ["activeTab", "tabs", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "icons": {
    "48": "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🤖%3C/text%3E%3C/svg%3E"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-bot": {
      "suggested_key": {
        "default": "Ctrl+Shift+J"
      },
      "description": "Toggle GyaanBot"
    }
  }
}
